<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>JeweleryAppBackend</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
	<ItemGroup> 
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.5" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.5" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.14" />
		<PackageReference Include="Microsoft.Playwright" Version="1.58.0" /> 

	</ItemGroup>
	<Target Name="PlaywrightInstall" AfterTargets="Publish">
		<Exec Command="playwright install chromium" />
	</Target>
  <ItemGroup>
    <Reference Include="Orleans.Core.Abstractions">
      <HintPath>..\build\Orleans.Core.Abstractions.dll</HintPath>
    </Reference> 
    <Reference Include="NLog">
      <HintPath>..\build\NLog.dll</HintPath>
    </Reference> 
    <Reference Include="System.Drawing.Common">
      <HintPath>..\build\System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="Stripe.net">
      <HintPath>..\build\Stripe.net.dll</HintPath>
    </Reference>
    <Reference Include="System.IdentityModel.Tokens.Jwt">
      <HintPath>..\build\System.IdentityModel.Tokens.Jwt.dll</HintPath>
    </Reference> 
    <Reference Include="NLog.Web.AspNetCore">
      <HintPath>..\build\NLog.Web.AspNetCore.dll</HintPath>
    </Reference>
    <Reference Include="Swashbuckle.AspNetCore.SwaggerGen">
      <HintPath>..\build\Swashbuckle.AspNetCore.SwaggerGen.dll</HintPath>
    </Reference>
    <Reference Include="Swashbuckle.AspNetCore.Swagger">
      <HintPath>..\build\Swashbuckle.AspNetCore.Swagger.dll</HintPath>
    </Reference>
    <Reference Include="Swashbuckle.AspNetCore.SwaggerUI">
      <HintPath>..\build\Swashbuckle.AspNetCore.SwaggerUI.dll</HintPath>
    </Reference>
    <Reference Include="NLog.Extensions.Logging">
      <HintPath>..\build\NLog.Extensions.Logging.dll</HintPath>
    </Reference> 
  </ItemGroup>
</Project>