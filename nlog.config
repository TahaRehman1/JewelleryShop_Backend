<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets> 
		<target xsi:type="File" name="DebugFile" fileName="C:\Logs\TheCaratsBackend\Debug_${shortdate}.log" layout="${longdate} ${threadid} ${uppercase:${level}} ${message}"/>
		<target xsi:type="File" name="ErrorFile" fileName="C:\Logs\TheCaratsBackend\Error_${shortdate}.log" layout="${longdate} ${threadid} ${uppercase:${level}}  ${message} ${newline} ${exception:format=tostring} ${newline}"/>
	</targets>

	<rules>
		<logger name="*" levels="Debug,Info,Warn" writeTo="DebugFile" />

		<logger name="*" level="Error" writeTo="ErrorFile"/>
	</rules>
</nlog>
